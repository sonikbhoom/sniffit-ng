# Sniffit NG runtime options.
# Payload inspection is disabled unless explicitly enabled.
inspect_payloads = false

# Full Decode shows complete captured packet bytes for TCP/23 flows in hex.
# It retains at most 8 recent frames in memory and may expose credentials.
full_decode = false
# To enable, make this exact acknowledgment active as well.
# ## User acknowledges Telnet hex display can expose credentials and private traffic.

# External IP lookup is disabled unless explicitly enabled. If the selected
# interface has an RFC 1918 IPv4 address, enabling this sends one HTTPS request
# to ifconfig.io when live capture starts.
resolve_external_addr = false

# Show bounded IPv4 metadata when no built-in simple decoder exists.
show_raw_flows = false

# Priority matches are always red and sorted first, then by total observed bytes.
ui_priority = 22/tcp,23/tcp

# Protocols hidden from the default flow list. They remain available by
# selecting them (or "all") with the protocol filter (key 5). Comma-separated; supported
# values are tcp, udp, icmp, igmp, vrrp. Use "hide_protocol =" to hide nothing.
# Traffic of any other protocol is always listed.
hide_protocol = icmp

# Opt-in: append one JSON line per inbound packet to a ui_priority port to this
# absolute path (owner-only 0600 file). Off by default. Can grow quickly.
# priority_log = /var/log/sniffit-ng/priority.jsonl
# Rotation: the log rolls to PATH.1 .. PATH.N when it reaches priority_log_max_mb
# (1-1024, default 10) or when the UTC day changes; N is priority_log_keep (1-100, default 7).
# priority_log_max_mb = 10
# priority_log_keep = 7

# Enable statically linked researcher-supplied protocol extensions.
# Compiled extension code is trusted executable code and is not sandboxed.
tainted_extensions = false

# Decoder keys accept "raw" or "simplified". Researcher-supplied extensions
# for every module require tainted_extensions = true; native extensions are
# trusted in-process code, not sandboxed. Built-in summaries need no taint opt-in.
icmp = simplified
igmp = simplified
tcp = simplified
http = simplified
dns = simplified
tls = simplified
tacacs = simplified
syslog = simplified
udp = simplified
dhcp4 = simplified
snmp = simplified
ntp = simplified
quic = simplified
rtp = simplified
rtcp = simplified
radius = simplified
vrrp = simplified
telnet = simplified
ssh = simplified

# To acknowledge payload inspection, enable the option and make the next line active
# by removing its leading '# ' characters. This acknowledgment is stored in this
# config file and will not be prompted on every run.
# ## User has acknowledged to behave ethically and inspect only authorized traffic.
